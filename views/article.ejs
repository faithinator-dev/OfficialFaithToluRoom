<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#0a192f"><meta name="description" content="<%= description %>"><meta property="og:title" content="<%= title %>"><meta property="og:description" content="<%= description %>"><meta property="og:type" content="article">
<link rel="canonical" href="https://coft-teal.vercel.app/journal/<%= article.slug %>"><meta name="twitter:card" content="summary"><title><%= title %></title><link rel="stylesheet" href="/css/portfolio.css">
  <link rel="stylesheet" href="/css/premium-polish.css"></head>
<body><a class="skip-link" href="#content">Skip to content</a><header class="site-header page-site-header"><div class="header-inner"><a class="wordmark" href="/"><span class="wordmark-mark">F</span><span>faith<span class="wordmark-dot">.</span></span></a><nav class="primary-nav page-nav" aria-label="Page navigation"><a href="/">Home</a><a href="/#work">Work</a><a href="/mobile">Mobile</a><a href="/journal">Journal</a></nav></div></header>
<main id="content" class="page-width detail-page article-page"><a class="back-link" href="/journal">← Back to journal</a><p class="eyebrow"><span class="eyebrow-line"></span><%= article.category %></p><h1 class="article-title"><%= article.title %></h1><div class="article-meta"><%= article.date %> · <%= article.readTime %></div><p class="article-intro"><%= article.intro %></p><article class="article-body"><% article.sections.forEach(section => { %><section><h2><%= section.heading %></h2><p><%= section.body %></p></section><% }) %></article><aside class="article-takeaway"><span class="note-label">THE TAKEAWAY</span><p><%= article.takeaway %></p></aside></main>
<footer class="site-footer page-width"><a class="wordmark" href="/"><span class="wordmark-mark">F</span><span>faith<span class="wordmark-dot">.</span></span></a><p>Designed & built by Faith Toluwanimi.</p><span>© <%= new Date().getFullYear() %></span><a href="#content" class="back-top">Back to top ↑</a></footer></body></html>
